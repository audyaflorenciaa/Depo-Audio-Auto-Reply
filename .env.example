# =============================================================
# DA AUTOLIGHT AI — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.
# =============================================================

# ------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------
# Your bot token from @BotFather on Telegram.
# Format: 123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------
# GEMINI (Google AI Studio)
# ------------------------------------------------------------
# Your API key from https://aistudio.google.com/
# Format: AIza...
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use. Do not change unless upgrading.
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
# The environment: "development" or "production"
APP_ENV=development

# The port the FastAPI server will listen on locally.
APP_PORT=8000

# Your public webhook URL (set this when deploying to production
# or using ngrok for local testing).
# Example: https://abc123.ngrok.io  OR  https://yourdomain.com
WEBHOOK_BASE_URL=https://your-ngrok-or-production-url.com

# The secret path for the webhook endpoint. Keep this random
# for security so random people cannot POST to your webhook.
# Example: a long random string like: xK9mP2qR7vL4nB8w
WEBHOOK_SECRET_PATH=your_random_secret_path_here

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Path where human-handoff logs will be saved.
HANDOFF_LOG_DIR=handoff_log

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
