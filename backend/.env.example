# =============================================================
# DA AUTOLIGHT AI — Backend Environment Variables Template
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the real values below.
# 3. NEVER commit .env to Git — it is already in .gitignore.
# =============================================================

# ------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------
# Your bot token from @BotFather on Telegram.
# Format: 123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------
# GEMINI (Google AI Studio)
# ------------------------------------------------------------
# Your API key from https://aistudio.google.com/
# Format: AIza...
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use. Do not change unless explicitly upgrading.
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
# Environment: "development" or "production"
APP_ENV=development

# Port the FastAPI server listens on locally.
APP_PORT=8000

# Your public-facing webhook URL.
# Dev example:   https://abc123.ngrok.io
# Prod example:  https://bot.yourdomain.com
WEBHOOK_BASE_URL=https://your-ngrok-or-production-url.com

# Secret path appended to the webhook URL for security.
# Use a long random string — e.g. run: python -c "import secrets; print(secrets.token_hex(16))"
WEBHOOK_SECRET_PATH=your_random_secret_path_here

# ------------------------------------------------------------
# LOGGING & STORAGE
# ------------------------------------------------------------
# Directory where human-handoff JSON logs are written.
HANDOFF_LOG_DIR=handoff_log

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------
# PHASE 2 — WhatsApp RAG (uncomment when ready)
# ------------------------------------------------------------
# Directory where exported WhatsApp .txt files are stored.
# WHATSAPP_EXPORT_DIR=data/whatsapp_exports

# Directory where the ChromaDB vector index will be persisted.
# VECTOR_DB_DIR=data/vector_db

# ------------------------------------------------------------
# PHASE 2+ — Supabase
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
